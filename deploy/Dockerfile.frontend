FROM node:22-alpine AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY data-agent-frontend-nuxt/package.json data-agent-frontend-nuxt/pnpm-lock.yaml data-agent-frontend-nuxt/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY data-agent-frontend-nuxt/ ./
RUN pnpm generate

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/.output/public /usr/share/nginx/html
EXPOSE 8080
