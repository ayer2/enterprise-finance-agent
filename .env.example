# Copy this file to .env, then replace every CHANGE_ME value locally.
# Never commit .env or paste real credentials into issues, screenshots, or logs.

# MySQL root account used only for schema initialization and management storage.
M7_MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_32_chars

# Read-only account used by the Agent to query the synthetic enterprise_demo database.
# Allowed characters: A-Z a-z 0-9 . _ ~ - ; length: 16-128.
ENTERPRISE_DEMO_READONLY_PASSWORD=CHANGE_ME_readonly_password_32

# Optional host ports. Change them only when the defaults are already occupied.
M7_FRONTEND_PORT=3000
M7_BACKEND_PORT=8065
M7_MYSQL_PORT=3307
